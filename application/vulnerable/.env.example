# =============================================================================
#  Cloud Security Lab — .env.example
#  Copy to .env and fill in real values for local development.
#  For ECS deployment, these are injected by the task definition.
# =============================================================================
#
#  NEVER commit a populated .env file to git.
#  The GitHub Actions workflow demonstrates what happens when you do.
#
# =============================================================================

# ---------------------------------------------------------------------------
# AWS Configuration
# ---------------------------------------------------------------------------

# AWS region where all resources are deployed (eu-west-3 = Paris per design)
AWS_REGION=eu-west-3

# S3 bucket name for tenant data (include the random suffix from Terraform output)
# Format: sec-lab-data-prod-<random-suffix>
S3_BUCKET=sec-lab-data-prod-changeme

# ---------------------------------------------------------------------------
# LocalStack (local development only)
# ---------------------------------------------------------------------------

# Set to "true" to route all AWS SDK calls to LocalStack instead of real AWS
USE_LOCALSTACK=true

# LocalStack endpoint URL (used when USE_LOCALSTACK=true)
LOCALSTACK_ENDPOINT=http://localstack:4566

# ---------------------------------------------------------------------------
# PostgreSQL / RDS
# ---------------------------------------------------------------------------

# RDS endpoint (for ECS) or "postgres" (Docker Compose service name)
DB_HOST=localhost

DB_PORT=5432

# Database name (matches RDS database name in Terraform)
DB_NAME=tenantdb

# Master username (stored in Secrets Manager rds/credentials in AWS)
DB_USER=dbadmin

# Master password — injected from Secrets Manager via ECS task definition
# For local dev only — never put real creds here
DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# [VULN-6] Path 2 demonstration — IAM user static credentials
# ---------------------------------------------------------------------------
# These variables simulate the hardcoded credentials that appear in the
# GitHub Actions pipeline config file (see .github/workflows/deploy.yml).
#
# In the real misconfiguration, these are committed directly to the pipeline
# YAML, not loaded from an env file. They are shown here for documentation.
#
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY for the IAM user
# sec-lab-pipeline-user-dev in the dev account.
# [VULN-6] Static long-lived credentials — should use OIDC instead.

# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ---------------------------------------------------------------------------
# ECS Task — set automatically by the Fargate runtime, documented here
# for reference during local XXE lab exercises
# ---------------------------------------------------------------------------

# The Fargate IMDS credential endpoint path — set by ECS at container start.
# An XXE payload that resolves http://169.254.170.2${AWS_CONTAINER_CREDENTIALS_RELATIVE_URI}
# will receive the API Task Role's temporary credentials as a JSON blob.
#
# AWS_CONTAINER_CREDENTIALS_RELATIVE_URI=/v2/credentials/<task-uuid>
