# =============================================================================
#  Cloud Security Lab — Phase 2 .env.example
#  Copy to .env for local development only.
#  For ECS deployment, Terraform injects these values in the task definition.
# =============================================================================

# Never commit a populated .env file.

AWS_REGION=eu-west-3
S3_BUCKET=sec-lab-data-prod-changeme

# LocalStack for local development
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localstack:4566

# PostgreSQL / RDS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tenantdb
DB_USER=dbadmin
DB_PASSWORD=changeme

# Phase 2 CI/CD uses GitHub OIDC.
# No AWS access keys are required in this repository.
